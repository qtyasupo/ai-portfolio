# 本机无需数据库账号。默认使用 .radar/radar.db（SQLite）。
# Vercel 未设置远程数据库时，只读展示 data/public-snapshot.json。
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 云端管理与外部推送必填；至少 24 个字符，不得加 NEXT_PUBLIC_ 前缀。
RADAR_ADMIN_TOKEN=
# 可选：OpenAI 兼容模型。不开通服务、不自动产生模型请求。
MODEL_CALLS_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_A=
LLM_MODEL_B=
# 本地工具可以通过环境变量指定路径，不要上传浏览器会话。
AGENT_REACH_BIN=
RADAR_PYTHON=python
