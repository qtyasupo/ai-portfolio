{
  "name": "yasupo-ai-creator-radar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4318",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest": "node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "snapshot": "node --env-file-if-exists=.env.local --import tsx scripts/export.ts",
    "collect": "python -X utf8 scripts/collect.py",
    "collector": "python -X utf8 scripts/collect.py --watch",
    "news:once": "python -X utf8 scripts/collect-news.py",
    "news:watch": "python -X utf8 scripts/collect-news.py --watch"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  }
}
